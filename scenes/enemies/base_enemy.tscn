[sub_resource type="CSharpScript" id="CSharpScript_lkvl6"]
script/source = "using Godot;

namespace Platformerz.scripts.enemies;

[GlobalClass]
public partial class FleeState : EnState
{
    private Vector2 _initialDirection;
    
    public override void Ready(EnStateMachine stateMachine)
    {
        Name = \"back\";
        fsm = stateMachine;
        base.Ready(stateMachine);
    }

    public override void Enter()
    {
        base.Enter();
        _initialDirection = fsm.Controller.MovementDirection;
    }

    public override EnState Update(float delta)
    {
        if (fsm.Controller.TargetPlayer is null)
        {
            GD.Print(\"Returning to move\");
            return fsm.EnStates[\"move\"];
        }
        fsm.Controller.MovementDirection = _getMovementVector();
        return base.Update(delta);
    }
    
    private Vector2 _getMovementVector()
    {
        return -fsm.Controller.GlobalPosition.DirectionTo(fsm.Controller.TargetPlayer.GlobalPosition);
    }
}
"

